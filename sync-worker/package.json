{
  "name": "chezzflix-sync",
  "private": true,
  "version": "1.0.0",
  "description": "Tiny Cloudflare Worker that stores each person's Chezzflix settings, so they follow them from device to device.",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler-dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create chezzflix-sync",
    "db:init": "wrangler d1 execute chezzflix-sync --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute chezzflix-sync --local --persist-to .wrangler-dev --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
